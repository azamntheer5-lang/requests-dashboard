# ==============================================================
# متغيرات البيئة — واجهة قناة الطلبات (Vercel)
# انسخ هذا الملف إلى .env.local للتطوير المحلي، وأدخل نفس القيم في
# Vercel → Project → Settings → Environment Variables
# ==============================================================

# رمز فتح لوحة التحكم (8 أرقام) — إلزامي للوحة المشرف
DASHBOARD_PIN=12345678

# رابط خدمة البوت على Render (الانضمام الفوري/بالكود + حالة الأسطول)
# هذا هو الرابط العام لخدمة البوت v2 — بدون شرطة مائلة في النهاية
E3FY2_SERVICE_URL=https://whatsapp-userbot-e3fy2.onrender.com

# مفاتيح سوبابس (Project Settings → API → service_role secret)
# service_role وليس anon — تُستخدم من API Routes فقط (server-side)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# (اختياري) لوحة مراقبة النشر — حالة الخدمة الحية على Render
RENDER_SERVICE_URL=https://um-raham-bot.onrender.com
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
WABOT_COMMIT_SHA=
